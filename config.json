  "panel_icon": "mdi:radiator",
  "ports": {
    "8100": 8100
  },
  "options": {
    "server_port": 8100
  },
  "schema": {
    "server_port": "int"
  },
  "environment": {
    "SERVER_PORT": "8100"
  },
  "webui": "http://[HOST]:[PORT:8100]"
}
