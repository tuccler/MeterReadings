{
  "name": "Heizkostenverteiler Dokumentation",
  "version": "1.0.0",
  "slug": "heater-meter-logger",
  "description": "Addon zur Dokumentation von Heizkostenverteiler-Ablesewerten mit Langzeitarchiv und Grafana-kompatibler Metriken-Schnittstelle.",
  "arch": ["amd64", "armv7", "armhf", "aarch64"],
